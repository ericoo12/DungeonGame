# ---- Godot 4+ ----
# Godot's local editor cache. Never commit this — it's regenerated automatically
# and differs per-machine, so committing it causes constant fake "changes".
.godot/

# Import cache (Godot 3 leftover path, harmless to keep ignored even on Godot 4)
.import/

# Exported/packaged builds
export.cfg
export_presets.cfg

# Mono/C# specific (only relevant if you ever use C# instead of GDScript)
.mono/
data_*/
mono_crash.*.json

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor/IDE junk ----
.vscode/
.idea/
*.swp

# ---- Godot translation cache (auto-generated) ----
*.translation

# ---- Misc build/log output ----
*.log
